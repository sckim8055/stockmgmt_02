# deploy/.env 로 복사해서 채운다. 이 파일(.env)은 저장소에 올리지 않는다.
# 비밀번호는 영문 대소문자와 숫자로만 길게 만든다(24자 이상 권장).
# 기호를 쓰지 않는다: @ : / ? # % 는 접속 주소 안에서 다른 뜻이 되고, $ 는 이 파일에서 변수로 풀려 값이 바뀐다.

# DB 소유자(postgres) 비밀번호. 구조 변경과 백업에만 쓴다.
DB_OWNER_PASSWORD=
# 앱 전용 역할(stock_app) 비밀번호. 16자 이상.
DB_APP_PASSWORD=

# 시스템 관리자가 로그인 화면의 기업코드 칸에 입력하는 운영사 코드
OPERATOR_CODE=OPERATOR
# HTTPS 로 접속하게 하면 true(기본). 이 PC 에서 http://localhost 로만 시험할 때만 false.
COOKIE_SECURE=true
# 접속자 IP 를 담아 주는 프록시 헤더. Cloudflare Tunnel 이면 cf-connecting-ip. 비워 두면 IP 를 기록하지 않는다.
TRUSTED_IP_HEADER=
# 앱이 열 포트(이 PC 안에서만 열린다)
APP_PORT=3000

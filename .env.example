# 앱 서버가 쓰는 접속 주소. 반드시 제한된 역할(stock_app)로 접속한다. 소유자 계정을 넣지 않는다.
DATABASE_URL=postgres://stock_app:CHANGE_ME@localhost:5432/stockmgmt
# 마이그레이션 전용 접속 주소(테이블 소유자). 앱 서버 실행 환경에는 넣지 않는다.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/stockmgmt
# 시스템 관리자가 로그인 화면의 기업코드 칸에 입력하는 운영사 코드
OPERATOR_CODE=OPERATOR
# 운영(HTTPS)에서는 true. 로컬 http 개발에서만 false.
COOKIE_SECURE=false
